{
  "expo": {
    "name": "BusHubLK Driver",
    "slug": "bushublk-driver-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#dc2626"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bushublk.driverapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#dc2626"
      },
      "package": "com.bushublk.driverapp"
    },
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
